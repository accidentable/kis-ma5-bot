# 모의투자 봇 설정 (ma5-bot-mock 서비스가 ENV_FILE 로 읽는다)
# 서버에서: cp .env.mock.example .env.mock && chmod 600 .env.mock 후 값 채우기
# 실전 .env 와 같은 칸이라도 여기 값만 쓴다 (실전 .env 는 읽지 않는다).

KIS_ENV=mock
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_MOCK_ACCOUNT_NO=

# 모의 계좌라 실제 돈이 안 나간다. 대회 체결을 쌓으려면 false.
DRY_RUN=false

# 실전과 상태·토큰을 섞지 않는다
DATA_DIR=data-mock
STATE_BACKEND=local
TOKEN_CACHE=file

# 모의용 텔레그램 봇 (실전 봇과 다른 토큰이어야 한다 — 같은 토큰을 두 프로세스가 폴링하면 409 충돌)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
BOT_LABEL=모의

STRATEGY=contest
# 한투모투배틀 2026-10-12 ~ 11-20. 이 날부터 목표 락·조건용 매매를 한 기간으로 센다 (11/1 에 리셋 안 됨)
CONTEST_START=2026-10-12
# 대회 '지수 종목 5개 거래' 조건용 1주 매매
CT_FILLER_N=4
