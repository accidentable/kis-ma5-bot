# ── 한국투자증권 Open API ───────────────────────────────────
# apiportal.koreainvestment.com 에서 발급. 실전/모의 키는 서로 호환되지 않음.
# real : 실전 (KIS_APP_KEY 등, openapi.koreainvestment.com:9443)
# mock : 모의투자 (KIS_MOCK_APP_KEY 등, openapivts.koreainvestment.com:29443)
#        토큰 캐시(kis_token_mock.json)·봇 상태(state_mock.json)는 실전과 따로 둔다.
#        모의는 휴장일 조회·정정취소가능주문조회가 안 돼서 평일 판정·주문체결조회로 대신한다.
KIS_ENV=real

# 실전 계좌
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 10자리: 종합계좌 8자리 + 상품코드 2자리 (예: 1234567801)
KIS_ACCOUNT_NO=

# 모의투자 계좌 (KIS_ENV=mock 일 때만 쓴다)
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_MOCK_ACCOUNT_NO=
# 조회 유량 (초당). 기본 실전 2.5, 모의 1.5 (모의 한도는 초당 2건)
# KIS_RATE_LIMIT_PER_SEC=

# ── 텔레그램 ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# 쉼표 구분. 본인 chat_id 외에는 명령을 받지 않는다.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── 실행 옵션 ────────────────────────────────────────────────
# true 면 주문 API를 호출하지 않고 로그/알림만 남긴다. 처음엔 반드시 true 로 검증할 것.
DRY_RUN=true

# 상태 저장 백엔드: local(JSON 파일) | dynamodb
STATE_BACKEND=local
AWS_REGION=ap-northeast-2
DYNAMODB_TABLE=ma5-bot-state
# 토큰 캐시: ssm 이면 SSM Parameter Store, file 이면 로컬 파일
TOKEN_CACHE=file

# ── 전략 선택 ────────────────────────────────────────────────
# near_high (기본): 52주 신고가 근접 로테이션 — 시총 상위 200 중 신고가에 가장 가까운 2종목, 21거래일마다 교체
# closebet        : 종가 베팅 (강세 마감 테마주 종가 매수 → 다음 날 시가 매도). 선택형, 검증 미통과
# ma5             : 예전 MA5 돌파 역발상 (되돌리려면 이 줄을 STRATEGY=ma5 로)
STRATEGY=near_high
# contest         : 대회 모드 — 20일 모멘텀 1위 1종목 집중, 손절·추적 10%, 보유 10일, 월초 대비 +30% 면 전량 매도 후 현금.
#                   한 달 +30% 확률을 노린다 (2020~25 29%, −20% 확률 22%). 근거 backtest/results/contest_tail_20261002.md
# CT_SLOTS=1                  동시 보유 종목 수 (2 면 +30% 확률 21%, −30% 확률 절반)
# CT_LOCK_PCT=30              목표 락 % (순위권 기준이 +20% 면 20)
# CT_STOP_PCT=10  CT_TRAIL_PCT=10  CT_HOLD_DAYS=10  CT_LOOKBACK=20  CT_TOP_PCT=10
# CT_CRASH_ENABLED=true       폭락일(시장 −3% & 3σ) 급락주 전환
# CT_FILLER_N=4               월 첫 매수 때 다음 순위 4종목 1주씩 (대회 '지수 종목 5개 거래' 조건용). 0 = 끔
# NH_UNIVERSE_TOP=200          코스피+코스닥 시총 상위 N
# NH_SLOTS=2                   보유 종목 수 (계좌를 N 등분)
# NH_HOLD_DAYS=21              교체 주기 (거래일)
# NH_HIGH_LOOKBACK=250         신고가 기준 기간 (거래일)
# NH_MOM_DAYS=60               이 기간 수익률 > 0 인 종목만
# NH_MIN_VALUE=1000000000      20일 평균 거래대금 하한 (원)
# NH_REFILL=true               교체일이 아니어도 빈 슬롯을 그날 순위로 채운다
# NH_PREP_TIME=0820            순위 계산 (3~5분 걸린다)
# NH_ENTRY_TIME=0905           교체 매매
# NH_BUY_CUTOFF=1430           빈 슬롯 매수 재시도 마감
# NH_STOP_LOSS_PCT=0           손절 %. 0 = 없음 (백테스트는 손절 없이 검증)
# NH_MAX_DAILY_GAIN_PCT=10     최근 20일에 하루 이 % 이상 오른 급등 테마주는 뺀다. 0 = 끔
# NH_SURGE_EXIT_PCT=10         보유 종목이 하루 이 % 이상 오르면 15:15 마감 때 판다 (빈 자리는 다음 날 채움). 0 = 끔
#
# 패닉 모드 (near_high 위에 얹는 선택 기능, 기본 꺼짐)
# 장 마감 뒤 시장 평균 등락률이 −4% 이하면 다음 날 보유를 모두 팔고, 시총 1000위 안에서 최근 5일 가장 많이 빠진
# 과매도주 5종목을 같은 금액씩 사서 5거래일째 15:15 에 판다 (고가권 마감 · 거래대금 폭증 종목 제외)
# PANIC_ENABLED=false
# PANIC_MKT_DROP_PCT=4          급락일 기준 (시장 평균 등락률 %)
# PANIC_SLOTS=5                 패닉 때 살 종목 수
# PANIC_HOLD_DAYS=5             보유 거래일 (산 날 = 1일째)
# PANIC_PICK_TOP=1000           후보 시총 순위 상한
# PANIC_PICK_MIN_VALUE=2000000000  후보 20일 평균 거래대금 하한
# PANIC_SCAN_TIME=1535          급락 판정 시각 (시총 1500 종목 일봉, 모의투자 기준 약 10분)

# 대회 수상 조건 — 수동 매매 /progress 가 체결 내역을 모아 비교한다
# CONTEST_START=2026-11-02      대회 시작일. 비우면 이번 달 1일
# CONTEST_MIN_AMOUNT=500000000  매매금액 (체결 기준, 매수+매도 합계)
# CONTEST_MIN_DAYS=5            매매일수
# CONTEST_MIN_STOCKS=5          매매종목수 (코스피200 · 코스닥150 편입 여부는 직접 확인)

# ── 종가 베팅 (STRATEGY=closebet 일 때만, 선택형 — 백테스트 기대값 0 근처) ──
# CB_SLOTS=2  CB_RANK_TOP=30  CB_MIN_CHANGE_PCT=5  CB_MAX_CHANGE_PCT=29  CB_MIN_IBS=0.9
# CB_MIN_VALUE=5000000000  CB_REGIME=true  CB_BUY_TICKS=5
# CB_BUY_TIME=1521  CB_SELL_TIME=0845  CB_CHECK_TIME=0905

# ── MA5 전략 설정 (STRATEGY=ma5 일 때만. 안 쓰면 config.py 기본값) ──
# TAKE_PROFIT_PCT=3            익절 % (종가 기준)
# TP_INTRADAY_ATR_BUFFER=0.5   장중 익절선 = 종가 익절선 + 이 값×ATR (손절 여유폭과 대칭)
# MAX_HOLD_TRADING_DAYS=3      최대 보유 거래일 (진입일 = 1일차)
# INTRADAY_REENTRY=true        청산으로 슬롯이 비면 장중 재진입
# REENTRY_START=0910           재진입 허용 시작 (HHMM)
# REENTRY_CUTOFF=1430          재진입 마감 (HHMM)
# NO_SAME_DAY_REENTRY=true     당일 매매한 종목은 그날 다시 안 산다
# TREND_MA_SHORT=20            추세 필터: 이 이평선이
# TREND_MA_LONG=60             이 이평선 위여야 한다 (골든크로스 상태)
# CROSS_LOOKBACK=30            골든크로스 탐색 범위 (거래일). 랭킹 신선도 계산용
# RANK_W_CROSS=1.0             랭킹 가중치 — 골든크로스 신선도
# RANK_W_DEPTH=0.5             랭킹 가중치 — 눌림 깊이
# USE_STOP_LOSS=false          손절 사용 여부
# STOP_LOSS_PCT=3              손절 %
# PREP_TIME=0840               일봉 받아 후보 계산·캐시
# PREMARKET_ENTRY_TIME=0850    프리마켓 판정 → 선주문
# ENTRY_TIME=0905              단일 진입 / 선주문 정리
# PREMARKET_SPLIT_ENTRY=true   프리마켓 선주문 사용
# PREOPEN_OFFSET_ATR=-0.5      10:00 전 진입은 기준가 + 이 값×ATR 에 걸어두고 장 초반 눌림을 기다린다
# PREOPEN_CHASE_PCT=0          기준가 % 보정 (보통 0)
# SPLIT_TRANCHES=1             선주문 건수 (2 이상이면 분할 — 권하지 않음)
# SPLIT_CANCEL_AT=1000         눌림 대기 마감. 안 빠졌으면 취소하고 현재가로 한 번에 매수
# STOP_BLACKOUT_UNTIL=1000     이 시각 전엔 급이탈·손절 안 봄 (익절만)
# INTRADAY_MA5_ATR_BUFFER=1.0  장중 5일선 이탈 여유폭 (ATR 배수)
