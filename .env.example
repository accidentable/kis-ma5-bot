# ── 한국투자증권 Open API (실전 계좌) ─────────────────────────
# apiportal.koreainvestment.com 에서 발급. 실전/모의 키는 서로 호환되지 않음.
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 10자리: 종합계좌 8자리 + 상품코드 2자리 (예: 1234567801)
KIS_ACCOUNT_NO=

# ── 텔레그램 ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# 쉼표 구분. 본인 chat_id 외에는 명령을 받지 않는다.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── 실행 옵션 ────────────────────────────────────────────────
# true 면 주문 API를 호출하지 않고 로그/알림만 남긴다. 처음엔 반드시 true 로 검증할 것.
DRY_RUN=true

# 상태 저장 백엔드: local(JSON 파일) | dynamodb
STATE_BACKEND=local
AWS_REGION=ap-northeast-2
DYNAMODB_TABLE=ma5-bot-state
# 토큰 캐시: ssm 이면 SSM Parameter Store, file 이면 로컬 파일
TOKEN_CACHE=file

# ── 전략 (선택 — 안 쓰면 config.py 기본값) ─────────────────
# TAKE_PROFIT_PCT=3            익절 % (종가 기준)
# TP_INTRADAY_ATR_BUFFER=0.5   장중 익절선 = 종가 익절선 + 이 값×ATR (손절 여유폭과 대칭)
# MAX_HOLD_TRADING_DAYS=3      최대 보유 거래일 (진입일 = 1일차)
# INTRADAY_REENTRY=true        청산으로 슬롯이 비면 장중 재진입
# REENTRY_START=0910           재진입 허용 시작 (HHMM)
# REENTRY_CUTOFF=1430          재진입 마감 (HHMM)
# NO_SAME_DAY_REENTRY=true     당일 매매한 종목은 그날 다시 안 산다
# TREND_MA_SHORT=20            추세 필터: 이 이평선이
# TREND_MA_LONG=60             이 이평선 위여야 한다 (골든크로스 상태)
# CROSS_LOOKBACK=30            골든크로스 탐색 범위 (거래일). 랭킹 신선도 계산용
# RANK_W_CROSS=1.0             랭킹 가중치 — 골든크로스 신선도
# RANK_W_DEPTH=0.5             랭킹 가중치 — 눌림 깊이
# USE_STOP_LOSS=false          손절 사용 여부
# STOP_LOSS_PCT=3              손절 %
# PREP_TIME=0840               일봉 받아 후보 계산·캐시
# PREMARKET_ENTRY_TIME=0850    프리마켓 판정 → 선주문
# ENTRY_TIME=0905              단일 진입 / 선주문 정리
# PREMARKET_SPLIT_ENTRY=true   프리마켓 선주문 사용
# PREOPEN_OFFSET_ATR=-0.5      10:00 전 진입은 기준가 + 이 값×ATR 에 걸어두고 장 초반 눌림을 기다린다
# PREOPEN_CHASE_PCT=0          기준가 % 보정 (보통 0)
# SPLIT_TRANCHES=1             선주문 건수 (2 이상이면 분할 — 권하지 않음)
# SPLIT_CANCEL_AT=1000         눌림 대기 마감. 안 빠졌으면 취소하고 현재가로 한 번에 매수
# STOP_BLACKOUT_UNTIL=1000     이 시각 전엔 급이탈·손절 안 봄 (익절만)
# INTRADAY_MA5_ATR_BUFFER=1.0  장중 5일선 이탈 여유폭 (ATR 배수)
