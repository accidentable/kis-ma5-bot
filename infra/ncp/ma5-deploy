#!/usr/bin/env bash
# ma5-bot 배포: 최신 코드 받기 → 의존성 → 테스트 → 연결 점검 → 재시작
# 서버에서는 /usr/local/bin/ma5-deploy 로 설치된다 (infra/terraform/init.sh.tftpl 가 복사).
#   sudo ma5-deploy [브랜치]
set -euo pipefail
cd /opt/ma5-bot
BR="${1:-__DEFAULT_BRANCH__}"
git fetch origin
git checkout "$BR"
git pull --ff-only origin "$BR"
./.venv/bin/pip install -q -r requirements.txt
for t in tests/test_rotation.py tests/test_panic.py tests/test_closebet.py tests/test_manual.py; do
  ./.venv/bin/python "$t" > /tmp/ma5-test.log 2>&1 || { echo "테스트 실패: $t"; tail -20 /tmp/ma5-test.log; exit 1; }
done
./.venv/bin/python cli.py check
systemctl restart ma5-bot
sleep 3
systemctl is-active ma5-bot
tail -20 /opt/ma5-bot/bot.log
